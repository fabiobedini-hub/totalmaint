# Copy this file to .env and fill in.
# For plain local testing (run_local.bat) you need none of this.

# --- Docker / NAS only ---
POSTGRES_PASSWORD=change-this-long-password
# Any long random string. Changing it logs everybody out.
SECRET_KEY=change-this-to-a-long-random-string-of-at-least-32-chars

# The address you open the app on. Used in calendar links and reminder e-mails.
# Locally: http://localhost:8080   With Tailscale: http://ds723:8080
PUBLIC_URL=http://localhost:8080

# --- E-mail reminders (optional) ---
# Example for Gmail: smtp.gmail.com, port 587, your address, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_HOUR=7

# Registering a new family from the log-in screen (the person who registers becomes its owner):
#   open = anyone who can reach the app, closed = only through invitations
SIGNUP=open
# Optional: also require this code to register (hand it to the families you want)
SIGNUP_CODE=
# Days an invitation link stays valid
INVITE_DAYS=14
# Hours a "forgot password" link stays valid (the link is e-mailed, so SMTP must be set up)
RESET_HOURS=2

# ---- TotalMant Admin: the console for you, on port 8081 (home network and Tailscale only) ----
# At least 10 characters, and different from your app password. Empty = the console stays locked.
ADMIN_PASSWORD=
# Hours before the console asks for the password again
ADMIN_SESSION_HOURS=12
